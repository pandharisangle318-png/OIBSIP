# VYOM configuration - copy this file to ".env" (setup.bat does it for you) and fill in your own values.
# NEVER share your .env file or commit it to GitHub. Every feature you leave blank is simply disabled.

# --- Email (Gmail) ---------------------------------------------------------
# Use a Gmail APP PASSWORD (16 characters), not your normal Gmail password. See README section 17.
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password

# --- Weather (OpenWeatherMap) ------------------------------------------------
# Free key from https://openweathermap.org/api  (new keys can take up to 2 hours to activate)
OPENWEATHER_API_KEY=your_openweather_api_key_here
